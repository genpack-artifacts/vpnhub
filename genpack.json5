{
    name:"vpnhub",
    compression:"xz",
    profile: "systemimg",
    packages:[
        "app-arch/lz4",
        "app-arch/zip",
        "app-crypt/easy-rsa",
        "app-editors/bvi",
        "dev-vcs/git",
        "net-dns/dnsmasq",
        "net-libs/nodejs",
        "net-misc/s3cmd",
        "net-vpn/openvpn",
        "sys-block/zram-init",
        "sys-fs/inotify-tools",
        "net-analyzer/zabbix",

        "www-servers/nginx",
        "net-vpn/frp",
        "www-servers/caddy",
        "net-misc/geoipupdate",
        "www-apache/mod_maxminddb",
        "www-apache/mod_authnz_external",
        "dev-lua/luajson",
        "dev-lua/luasec",
        "net-firewall/ipsum2nft",
        "net-firewall/geoipsets",

        "app-crypt/certbot",
        "dev-python/pip",
        "dev-python/pyinotify",
        "dev-python/twisted",

        "dev-db/mysql",
        "dev-db/mysql-init-scripts",
        "dev-python/mysqlclient",

        "net-vpn/wireguard-tools",
        "mail-mta/postfix",
        "mail-filter/opendkim",
        "app-admin/logrotate",

        "dev-libs/iniparser",
        "sys-auth/pam_mysql",
        "app-backup/borgbackup",
    ],
    accept_keywords:{
        "net-analyzer/snort": null,
    },
    use:{
        "sys-apps/genpack-init": "exec-guard",
        "net-firewall/nftables": "json python xtables",
        "sys-libs/zlib": "minizip",
        "net-analyzer/zabbix": "-postgres proxy sqlite",
        "net-analyzer/fping": "suid",
        "app-misc/mime-types": "nginx",
        "net-libs/nodejs": "npm",
        "app-crypt/certbot": "certbot-dns-google certbot-dns-route53 certbot-dns-sakuracloud certbot-nginx",
        "www-servers/caddy": "dns-cloudflare dns-googlecloudns dns-route53 dynamicdns"
    },
    license:{
        "net-analyzer/fping": "fping",
    },
    services:[]
}
